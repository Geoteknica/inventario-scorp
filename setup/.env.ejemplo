# Copie este archivo como .env (en esta misma carpeta) y complete los valores.
# El archivo .env no se sube a GitHub.

SUPABASE_URL=https://qtpfddubmniknmshmqos.supabase.co

# Supabase → Project Settings → API Keys → Secret key (empieza con sb_secret_).
# No la comparta ni la ponga en el sitio web.
SUPABASE_SECRET_KEY=

ADMIN_EMAIL=rmoyano@estudiostecnicos.com
# Mínimo 10 caracteres.
ADMIN_PASSWORD=

# Ruta al archivo de límites municipales del Censo (con agua costera, EPSG:4326).
MUNICIPIOS_GEOJSON=municipios_censo.geojson
